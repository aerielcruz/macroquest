# Copy this file to .env and fill in the values. Never commit .env.

# MongoDB connection string (MongoDB Atlas > Connect > Drivers)
MONGODB_URI=
# Database name inside the cluster
MONGODB_DB=macroquest

# Long random string used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Google OAuth 2.0 Client ID (Google Cloud Console > APIs & Services > Credentials).
# Leave empty to hide the Google sign-in option.
GOOGLE_CLIENT_ID=

# Password for the researcher export page at /#admin
ADMIN_KEY=

PORT=3001

# Set to true to use MongoDB and Google sign-in (run with npm run dev:full).
# Leave false to save progress in the browser only.
VITE_USE_SERVER=false

# Only when the app and API are on different domains (Render static site + web service).
# Leave empty locally. render.yaml fills both in automatically.
# On the API: the app's address, e.g. https://macroquest.onrender.com
CORS_ORIGIN=
# On the app: the API's address, e.g. https://macroquest-api.onrender.com
VITE_API_URL=
